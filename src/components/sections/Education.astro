---
import Section from "../Section.astro"
import { education } from "@cv"
---

<Section title="Educación">
  <ul>
    {
      education.map(({ institution, startDate, endDate, area, studyType, url }) => {
        const startYear = new Date(startDate).getFullYear()
        const endYear =
          endDate != null ? new Date(endDate).getFullYear() : "Presente"
        const years = `${startYear} - ${endYear}`

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>
                    {url ? (
                      <a href={url} target="_blank" rel="noopener noreferrer" title={`Visitar ${institution}`}>
                        {institution}
                      </a>
                    ) : (
                      institution
                    )}
                  </h3>
                </div>

                <time>{years}</time>
              </header>

              <footer>
                <p>{area}</p>
                {studyType && <span class="study-type">{studyType}</span>}
              </footer>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article h3 a {
    color: #111;
  }

  article h3 a:hover {
    text-decoration: underline;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    text-align: right;
  }

  footer p {
    color: #333;
    font-size: 0.85rem;
  }

  .study-type {
    display: inline-block;
    margin-top: 4px;
    font-size: 0.7rem;
    color: #666;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>