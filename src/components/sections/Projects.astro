---
import Section from "../Section.astro"
import Github from "@/icons/Github.astro"
import { projects } from "@cv"

const featuredProjects = projects.slice(0, 4)
const otherProjects = projects.slice(4)
---

<Section title="Proyectos">
  <ul class="projects-grid">
    {
      featuredProjects.map(
        ({ url, description, highlights, name, isActive, github }) => {
          return (
            <li>
              <article>
                <header>
                  <h3>
                    <a href={url} target="_blank" rel="noopener noreferrer" title={`Ver el proyecto ${name}`}>
                      {name}
                    </a>
                    {isActive && <span class="active-dot" title="Proyecto activo">•</span>}
                    {github && github !== url && (
                      <a
                        class="github-code-link"
                        href={github}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`Ver código fuente del proyecto ${name} en GitHub`}
                      >
                        <Github />
                      </a>
                    )}
                  </h3>
                  <p>{description}</p>
                </header>
                <footer>
                  {highlights.map((highlight) => {
                    return <span>{highlight}</span>
                  })}
                </footer>
              </article>
            </li>
          )
        }
      )
    }
  </ul>

  {otherProjects.length > 0 && (
    <div class="more-projects-container" id="more-projects-container">
      <ul class="projects-grid extra-projects" id="extra-projects" hidden>
        {
          otherProjects.map(
            ({ url, description, highlights, name, isActive, github }) => {
              return (
                <li>
                  <article>
                    <header>
                      <h3>
                        <a href={url} target="_blank" rel="noopener noreferrer" title={`Ver el proyecto ${name}`}>
                          {name}
                        </a>
                        {isActive && <span class="active-dot" title="Proyecto activo">•</span>}
                        {github && github !== url && (
                          <a
                            class="github-code-link"
                            href={github}
                            target="_blank"
                            rel="noopener noreferrer"
                            title={`Ver código fuente del proyecto ${name} en GitHub`}
                          >
                            <Github />
                          </a>
                        )}
                      </h3>
                      <p>{description}</p>
                    </header>
                    <footer>
                      {highlights.map((highlight) => {
                        return <span>{highlight}</span>
                      })}
                    </footer>
                  </article>
                </li>
              )
            }
          )
        }
      </ul>

      <div class="toggle-wrapper no-print">
        <button
          id="toggle-projects-btn"
          class="toggle-btn"
          type="button"
          aria-expanded="false"
          aria-controls="extra-projects"
        >
          <span class="btn-label">Ver más proyectos ({otherProjects.length})</span>
          <svg
            class="chevron-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </div>
  )}
</Section>

<script>
  const toggleBtn = document.getElementById("toggle-projects-btn")
  const extraProjects = document.getElementById("extra-projects")
  const btnLabel = toggleBtn?.querySelector(".btn-label")
  const chevron = toggleBtn?.querySelector(".chevron-icon")

  if (toggleBtn && extraProjects && btnLabel) {
    const totalExtras = extraProjects.querySelectorAll("li").length

    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true"

      if (isExpanded) {
        extraProjects.setAttribute("hidden", "")
        toggleBtn.setAttribute("aria-expanded", "false")
        btnLabel.textContent = `Ver más proyectos (${totalExtras})`
        chevron?.classList.remove("rotated")
      } else {
        extraProjects.removeAttribute("hidden")
        toggleBtn.setAttribute("aria-expanded", "true")
        btnLabel.textContent = "Ver menos"
        chevron?.classList.add("rotated")
      }
    })
  }
</script>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-inline: -16px;
  }

  .extra-projects {
    margin-top: 1rem;
  }

  .extra-projects[hidden] {
    display: none;
  }

  article {
    border-radius: 8px;
    border: 1px solid #f2f2f2;
    gap: 16px;
    display: flex;
    flex-direction: column;
    padding: 16px;
    height: 100%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  article:hover {
    border-color: #ddd;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  article header {
    flex: 1;
  }

  article h3 {
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  article a {
    color: #111;
  }

  article a:hover {
    text-decoration: underline;
  }

  .github-code-link {
    display: inline-flex;
    align-items: center;
    color: #666;
    margin-left: 2px;
    transition: color 0.15s ease;
  }

  .github-code-link:hover {
    color: #000;
  }

  .github-code-link :global(svg) {
    width: 14px;
    height: 14px;
  }

  article p {
    font-size: 0.75rem;
    line-height: 1.25rem;
    margin-bottom: 4px;
    color: #555;
  }

  .active-dot {
    color: rgb(0, 188, 47);
    font-size: 1.2rem;
    line-height: 1;
    animation-name: flicker;
    animation-duration: 3s;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 0.6rem;
  }

  footer span {
    border-radius: 6px;
    background: #eee;
    color: #444;
    font-size: 0.65rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  .toggle-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    background: #f7f7f7;
    color: #444;
    border: 1px solid #e8e8e8;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    font-family: inherit;
  }

  .toggle-btn:hover {
    background: #eee;
    color: #111;
    border-color: #ddd;
  }

  .chevron-icon {
    transition: transform 0.2s ease;
  }

  .chevron-icon.rotated {
    transform: rotate(180deg);
  }

  @keyframes flicker {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
    100% {
      opacity: 1;
    }
  }

  @media (width <= 700px) {
    .projects-grid {
      margin-inline: 0px;
    }

    article {
      border: none;
      box-shadow: 0 1px 1px #f2f2f2;
      padding: 0 0 16px 0;
    }
  }

  @media print {
    article {
      page-break-inside: avoid;
    }
    .active-dot {
      animation-name: none;
    }
    .github-code-link {
      display: none;
    }
    .no-print {
      display: none !important;
    }
    .extra-projects[hidden] {
      display: grid !important;
    }
  }
</style>